# ==============================================================================
# SAHAAY - Production & Development Environment Configuration Template
# Citizen-First Land Acquisition & Compensation Companion
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development # Options: development | production | test
PORT=5000

# ------------------------------------------------------------------------------
# 2. CORS & Client Configuration
# ------------------------------------------------------------------------------
# For development: http://localhost:5173,http://localhost:3000
# For production: https://sahaay.vercel.app,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection (MANDATORY)
# ------------------------------------------------------------------------------
# Local PostgreSQL (Docker Compose / Localhost):
DATABASE_URL="postgresql://sahaay_user:sahaay_password@localhost:5432/sahaay_db?schema=public"

# Cloud Managed PostgreSQL (Neon / Supabase / Railway / AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-sample-12345.ap-south-1.neon.tech/sahaay_db?sslmode=require"

# ------------------------------------------------------------------------------
# 4. Authentication & Security (CRITICAL)
# ------------------------------------------------------------------------------
# In production, generate a secure random 64-character hex key:
# Run in terminal: openssl rand -hex 32
JWT_SECRET=sahaay_default_dev_jwt_secret_2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Document Intelligence & OCR Engine
# ------------------------------------------------------------------------------
# Options: ocr (Tesseract OCR + Regex Rule Extractor) | mock (Deterministic Fixtures) | openai (GPT-4 Vision)
AI_PROVIDER=ocr
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Document Storage Layer
# ------------------------------------------------------------------------------
# Options: local (Container/Disk Storage) | s3 (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=15

# Cloud S3 / Cloudflare R2 / Supabase Storage Settings (Required when STORAGE_PROVIDER=s3):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=sahaay-documents
# Custom S3 endpoint (e.g. for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com):
S3_ENDPOINT=
S3_PUBLIC_URL_PREFIX=

# ------------------------------------------------------------------------------
# 7. Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=15

# ------------------------------------------------------------------------------
# 8. PostgreSQL Database Container Config
# ------------------------------------------------------------------------------
POSTGRES_USER=sahaay_user
POSTGRES_PASSWORD=sahaay_password
POSTGRES_DB=sahaay_db
