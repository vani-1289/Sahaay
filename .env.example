# ==============================================================================
# SAHAAY - Global Environment Configuration Template
# Citizen-First Land Acquisition & Compensation Companion
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api
CORS_ORIGIN=http://localhost:5173

# Database Connection URL
# SQLite (Development default):
DATABASE_URL="file:./dev.db"
# PostgreSQL + PostGIS (Production):
# DATABASE_URL="postgresql://sahaay_user:sahaay_password@localhost:5432/sahaay_db?schema=public"

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_random_64_char_secret_in_production
JWT_EXPIRES_IN=7d

# AI Intelligence Service (mock | openai)
AI_PROVIDER=mock
OPENAI_API_KEY=

# Document Storage Configuration (local | s3)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=15
