{
  "name": "sahaay",
  "version": "1.0.0",
  "private": true,
  "description": "SAHAAY — Citizen-First Land Acquisition & Compensation Companion",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p server",
    "build:client": "npm --prefix client run build",
    "build": "npm run db:generate && npm run build:server && npm run build:client",
    "start": "node server/dist/index.js",
    "test": "npm run db:generate && tsx server/src/test/run-tests.ts",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "db:push": "npx prisma db push",

    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "typecheck": "tsc -p server --noEmit && tsc -p client --noEmit",
    "lint": "eslint \"server/src/**/*.{ts,tsx}\" \"client/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"server/src/**/*.{ts,tsx}\" \"client/src/**/*.{ts,tsx}\" --fix",
    "format:check": "prettier --check \"server/src/**/*.{ts,tsx}\" \"client/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"server/src/**/*.{ts,tsx}\" \"client/src/**/*.{ts,tsx}\"",
    "ci:check": "npm run db:generate && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
