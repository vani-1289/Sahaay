# ==============================================================================
# SAHAAY Server Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Connection URL
DATABASE_URL="file:../prisma/dev.db"
# PostgreSQL Production:
# DATABASE_URL="postgresql://sahaay_user:sahaay_password@localhost:5432/sahaay_db?schema=public"

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=sahaay_jwt_secret_key_super_secure_demo_2026_xyz
