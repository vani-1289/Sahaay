# AI Intelligence Service Engine (mock | openai)
AI_PROVIDER=mock
OPENAI_API_KEY=

# Document Storage Settings
STORAGE_PROVIDER=local
STORAGE_PATH=../storage
MAX_FILE_SIZE_MB=15
